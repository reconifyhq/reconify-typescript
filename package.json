{
  "name": "@reconifyhq/sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript SDK for the Reconify Public API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reconifyhq/reconify-typescript.git"
  },
  "homepage": "https://github.com/reconifyhq/reconify-typescript#readme",
  "keywords": [
    "reconify",
    "sdk",
    "typescript",
    "integrity",
    "reconciliation"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "llms.txt",
    "context7.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fetch-contract": "node scripts/fetch-contract.mjs",
    "generate": "node scripts/generate.mjs",
    "check-generated": "node scripts/check-generated.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-context7": "node scripts/check-context7.mjs",
    "coverage": "tsx scripts/check-openapi-coverage.ts",
    "verify": "npm run check-context7 && npm run typecheck && npm run build && npm test",
    "verify:openapi": "npm run fetch-contract && npm run check-generated && npm run coverage",
    "sync-contract": "node scripts/fetch-contract.mjs --latest && npm run generate && npm run coverage",
    "prepublishOnly": "npm run verify",
    "preversion": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "agent-base": "^7.1.4",
    "ansi-colors": "^4.1.3",
    "argparse": "^2.0.1",
    "assertion-error": "^2.0.1",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^2.1.2",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "change-case": "^5.4.4",
    "check-error": "^2.1.3",
    "colorette": "^1.4.0",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fast-deep-equal": "^3.1.3",
    "fdir": "^6.5.0",
    "fsevents": "^2.3.3",
    "https-proxy-agent": "^7.0.6",
    "index-to-position": "^1.2.0",
    "js-levenshtein": "^1.1.6",
    "js-tokens": "^4.0.0",
    "js-yaml": "^4.2.0",
    "json-schema-traverse": "^1.0.0",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "minimatch": "^5.1.9",
    "ms": "^2.1.3",
    "nanoid": "^3.3.16",
    "parse-json": "^8.3.0",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pluralize": "^8.0.0",
    "postcss": "^8.5.21",
    "require-from-string": "^2.0.2",
    "rollup": "^4.62.2",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "supports-color": "^10.2.2",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.4",
    "type-fest": "^4.41.0",
    "undici-types": "^6.21.0",
    "uri-js-replace": "^1.0.1",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0",
    "yaml-ast-parser": "^0.0.43",
    "yargs-parser": "^21.1.1"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/reconifyhq/reconify-typescript/issues"
  }
}
